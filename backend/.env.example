PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=1212
DB_NAME=SaaP
# Evidence storage (relative paths resolve from backend/ root)
EVIDENCE_STORAGE_ROOT=storage/evidence
EVIDENCE_MAX_UPLOAD_BYTES=15728640
# Compression mode: AUTO (gzip only if smaller), GZIP (always), NONE (disabled)
EVIDENCE_STORAGE_COMPRESSION=AUTO
# Evidence policy mode: OFF (disabled), RISKY (risk-only), ALWAYS (all post/reverse actions)
EVIDENCE_POLICY_MODE=RISKY
# In RISKY mode, require evidence on post when amountBase >= this threshold (empty disables threshold rule)
EVIDENCE_POLICY_RISKY_POST_AMOUNT_BASE_MIN=

JWT_SECRET=replace_this_with_a_long_secret
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
AUTH_TOKEN_EXPIRES_IN=7d
AUTH_COOKIE_NAME=saap_access
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_PATH=/
# AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_MAX_AGE_MS=604800000
AUTH_LOGIN_RATE_WINDOW_MS=900000
AUTH_LOGIN_RATE_MAX_ATTEMPTS=10
AUTH_LOGIN_RATE_BLOCK_MS=900000
AUTH_LOGIN_RATE_MAX_TRACKED_KEYS=10000
AUTH_LOGIN_RATE_STORE=auto
# AUTH_LOGIN_RATE_REDIS_URL=redis://localhost:6379
AUTH_LOGIN_RATE_REDIS_CONNECT_TIMEOUT_MS=2000
RBAC_CACHE_STORE=auto
# RBAC_CACHE_REDIS_URL=redis://localhost:6379
RBAC_CACHE_REDIS_CONNECT_TIMEOUT_MS=1500
RBAC_CACHE_TTL_MS=30000
RBAC_HIERARCHY_CACHE_TTL_MS=60000
RBAC_CACHE_MAX_ENTRIES=10000
RBAC_CACHE_TENANT_VERSION_TTL_MS=5000
PROVIDER_CONTROL_PANEL_ENABLED=false
PROVIDER_JWT_SECRET=replace_with_long_provider_jwt_secret
PROVIDER_BOOTSTRAP_ENABLED=false
PROVIDER_API_KEY=replace_with_long_random_provider_key
PROVIDER_ADMIN_EMAIL=admin@example.com
PROVIDER_ADMIN_PASSWORD=12121212
PROVIDER_ADMIN_NAME=Provider Admin
